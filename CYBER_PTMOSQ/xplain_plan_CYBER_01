        sem_num_doc,
    TRIM (CC.CON_COD_AREA_TELF) || TRIM (CC.CON_NUM_TELF)
        sem_telefono,
    TRIM (CC.CON_COD_AREA_TELF)
        sem_cod_area_tlf,
    TRIM (CC.CON_NUM_TELF)
        sem_num_tlf,
    CASE CC.CON_MARCA_CONT
        WHEN ' ' THEN ' '
        WHEN '1' THEN ' '
        ELSE CC.CON_MARCA_CONT
    END
        sem_marca_contacto,
    CC.CON_ORIGEN_CONTACTO
        sem_origen,
    CASE CC.CON_ORIGEN_CONTACTO
        WHEN 'CMO' THEN 3
        WHEN 'ALT' THEN 4
        ELSE 5
    END
        sem_prioridad,
    CC.CON_FECHA_SIST
        sem_fecha_registro,
    ROW_NUMBER ()
