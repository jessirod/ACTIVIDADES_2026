***************************************************************************************************


COL SEQUENCE_OWNER FORMAT A15
COL SEQUENCE_NAME FORMAT A40
SELECT SEQUENCE_OWNER
, SEQUENCE_NAME 
, CACHE_SIZE
, LTRIM(TO_CHAR(MAX_VALUE, '999999999999999999999999999999999999999999')) MAX_VALUE
FROM DBA_SEQUENCES
WHERE SEQUENCE_OWNER = 'INVPL'
AND SEQUENCE_NAME IN ('HOLIDAYS_SEQ', 'HOLIDAY_AUDIT_SEQ')
order by CACHE_SIZE
/

***************************************************************************************************

COL OWNER FORMAT A15
COL CONSTRAINT_NAME FORMAT A30
SELECT OWNER
, CONSTRAINT_NAME
, CONSTRAINT_TYPE
, TABLE_NAME
FROM DBA_CONSTRAINTS
WHERE TABLE_NAME IN ('HOLIDAYS', 'HOLIDAY_AUDIT');


