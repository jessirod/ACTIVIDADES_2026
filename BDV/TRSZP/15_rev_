informacion de los backups de TX

select session_key, to_char(start_time,'DD-MON HH24:MI:SS') inicio,
       to_char(end_time,'DD-MON HH24:MI:SS') fin,
       round(elapsed_seconds/60,1) minutos, input_type, status,
       input_bytes_display, output_bytes_display,
       input_bytes_per_sec_display lectura_por_seg, output_device_type, compression_ratio
from v$rman_backup_job_details
where start_time >= timestamp '2026-11-13 18:00:00'
order by start_time;





