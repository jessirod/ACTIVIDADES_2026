-- cuánto flashback se escribe por hora frente al redo
select to_char(begin_time,'DD-MON HH24:MI') hora,
       round(flashback_data/1024/1024/1024,1) flashback_gb,
       round(redo_data/1024/1024/1024,1)      redo_gb,
       round(db_data/1024/1024/1024,1)        db_gb
from v$flashback_database_stat order by begin_time;

