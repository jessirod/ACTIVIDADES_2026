CREATE TABLE PCP.ORDEN_HIST
(
  ID_ORDEN                   NUMBER(30)         NOT NULL,
  ID_NUM_REQUEST             VARCHAR2(58 BYTE),
  REFERENCE_NUMBER_LOTE      NUMBER(20),
  CUSTOMER_DESCRIPTION       VARCHAR2(256 BYTE),
  CUSTOMER_ID                VARCHAR2(20 BYTE),
  ACCOUNT_NUMBER             VARCHAR2(20 BYTE),
  TOTAL_NUM_DEBITS           NUMBER(12),
  TOTAL_NUM_CREDITS          NUMBER(12),
  TOTAL_AMOUNT               NUMBER(20,2),
  STATUS                     NUMBER(2),
  DATE_VALUE                 DATE,
  RECORD_ENTRY_DATE          DATE,
  IS_LOADED_FROM_STG         VARCHAR2(1 BYTE),
  PRODUCT_NAME               VARCHAR2(30 BYTE),
  BUSINESS_STATUS_CODE       VARCHAR2(8 BYTE),
  NUMERO_TICKET              VARCHAR2(20 BYTE),
  ENVIADO_EMPRESA            VARCHAR2(1 BYTE),
  TOTAL_DEBITOS_PROCESADOS   NUMBER(20),
  TOTAL_DEBITOS_RECHAZADOS   NUMBER(20),
  TOTAL_CREDITOS_PROCESADOS  NUMBER(20),
  TOTAL_CREDITOS_RECHAZADOS  NUMBER(20),
  FECHA_APROBACION           DATE,
  FECHA_ENVIO_MONITOR        DATE,
  FECHA_RECEPCION_MONITOR    DATE,
  RESPUESTA_MONITOR          VARCHAR2(20 BYTE),
  EXPIRADO_MONITOR           VARCHAR2(1 BYTE),
  ENVIADO_MONITOR            VARCHAR2(1 BYTE)
)
NOCOMPRESS 
TABLESPACE DATA
PCTFREE    10
INITRANS   1
MAXTRANS   255
STORAGE    (
            BUFFER_POOL      DEFAULT
           )
PARTITION BY RANGE (DATE_VALUE)
INTERVAL (NUMTOYMINTERVAL(1, 'MONTH'))
(  
  PARTITION ORDEN_INICIAL VALUES LESS THAN (TO_DATE(' 2018-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN'))
    LOGGING
    NOCOMPRESS 
    TABLESPACE DATA
    PCTFREE    10
    INITRANS   1
    MAXTRANS   255
    STORAGE    (
                BUFFER_POOL      DEFAULT
               ),  
  PARTITION ORDEN_HIST_2 VALUES LESS THAN (TO_DATE(' 2022-02-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN'))
    LOGGING
    NOCOMPRESS 
    TABLESPACE DATA
    PCTFREE    10
    INITRANS   1
    MAXTRANS   255
    STORAGE    (
                INITIAL          8M
                NEXT             1M
                MINEXTENTS       1
                MAXEXTENTS       UNLIMITED
                BUFFER_POOL      DEFAULT
               )
)
NOCACHE;
