         BEGIN

           ---- SE INSERTA EL CUESTIONARIO QUE LLENA EL CONTRIBUYENTE

              Insert into ACTIVIDAD_ECONOMICA_CONTRIB
                         (ID_CONTRIBUYENTE,
                          CODIGO_ACT_ECONOMICA,
                          FECHA_REGISTRO_ACT_ECON,
                          NUMERO_CERTIFICADO,
                          DESCRIPCION_ACT_ECONOMICA)
                 Values (PN_ID_CONTRIBUYENTE,
                         PN_COD_ACT_ECONOMICA,
                         SYSDATE,
                         VN_CORRELATIVO,
                         VC_DESCRIPCION_AE);

          PN_RESULT:= PKG_CONSTANTES.OK;
           COMMIT;
           EXCEPTION

              WHEN OTHERS THEN
                       BEGIN
                         ROLLBACK;
                        pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4.P_INSERTAR_ACT_ECONOMICA ',
                                                                 'ID CONTRIBUYENTE :'||PN_ID_CONTRIBUYENTE  , 'DATOSCONTRIBUYENTE.CUESTIONARIO_ACT_ECONOMICA_C4',
                                                                 SUBSTR (SQLERRM, 1, 300), NULL, PN_RESULT );
                       END;



         END ;

    ELSE

        P_ACT_ECONOM_CONTRIB  (PN_ID_CONTRIBUYENTE,PN_COD_ACT_ECONOMICA,PN_RESULT );


     END IF;


