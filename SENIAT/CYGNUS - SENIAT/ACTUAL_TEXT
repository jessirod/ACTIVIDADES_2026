FUNCTION f_verifica_act_economica (PN_ID_CONTRIB  IN NUMBER)

 RETURN NUMBER

IS

 VN_IND_ACT_ECONOMICA NUMBER;
 RESULT  NUMBER;
 VN_INDICADOR NUMBER ;

BEGIN
      BEGIN

        --- verifica que el contribuyente NO sea consejo comunanales y comuna

        select 1
           INTO VN_INDICADOR
            from contribuyente c
            where c.ID_CONTRIBUYENTE = PN_ID_CONTRIB
              and c.SITUACION_CONTRIBUYENTE = '00'
              and c.PERSONALIDAD_CONTRIBUYENTE = 3
              and c.TIPO_SOCIEDAD_CONTRIBUYENTE NOT IN ('21','16') ;  ---- comuna o consejos comunales

          RESULT:= PKG_CONSTANTES.OK;


       EXCEPTION
          WHEN NO_DATA_FOUND THEN
            BEGIN
               VN_IND_ACT_ECONOMICA := PKG_CONSTANTES.ERR_GENERAL ; ---  -1 indica que el contribuyente es una comuna o consejo comunal

             END;

          WHEN OTHERS THEN
            BEGIN
             VN_IND_ACT_ECONOMICA := PKG_CONSTANTES.ERR_GENERAL  ;   ---  -1 indica que el contribuyente es una comuna o consejo comunal


            END ;

      END ;



    IF RESULT = PKG_CONSTANTES.OK  and VN_INDICADOR = 1 THEN

    BEGIN

      SELECT 1      ---- si el valor es 1 significa que tiene la actividad economica actualizada
      INTO   VN_IND_ACT_ECONOMICA
      FROM  ACTIVIDAD_ECONOMICA_CONTRIB AEC
      WHERE AEC.ID_CONTRIBUYENTE = PN_ID_CONTRIB;

       RESULT:= PKG_CONSTANTES.OK;

      EXCEPTION

          WHEN NO_DATA_FOUND THEN
            BEGIN
               VN_IND_ACT_ECONOMICA := PKG_CONSTANTES.Cn_Informacion_no_Disponible  ;   ---- si el valor es 0 significa que el contribuyente no tiene actualizada la actividad econo
mica


             END;

      END ;

    END IF;

     RETURN  VN_IND_ACT_ECONOMICA;

END f_verifica_act_economica;




PROCEDURE P_CONSULTAR_HISTORIAL_CONTRIB ( PC_RIF_CONTRIBUYENTE IN VARCHAR2,
                                          C_HISTORIAL  OUT CURSOR_GRUPO,
                                          PN_RESULT           OUT PLS_INTEGER)
IS

CORRELATIVO NUMBER ;

 BEGIN

         BEGIN

          --- CONSULA EL HISTORIAL DE UN CONTRIB DADO SU RIF

         OPEN C_HISTORIAL FOR


           SELECT TRIM(C.APELLIDO_CONTRIBUYENTE)||', '||TRIM(C.NOMBRE_CONTRIBUYENTE)RAZON_SOCIAL,
                  (SELECT TV.DESCRIPCION_TIPO_VIALIDAD FROM TIPO_VIALIDAD TV WHERE DC.TIPO_VIALIDAD_D_C = TV.CODIGO_TIPO_VIALIDAD)||' '||
                  TRIM(DC.VIALIDAD_DIR_CONTRIBUYENTE)||', '||
                  (SELECT TS.DESCRIPCION_TIPO_SECTOR FROM TIPO_SECTOR TS WHERE DC.TIPO_SECTOR_D_C = TS.CODIGO_TIPO_SECTOR)||' '||
                  TRIM(DC.SECTOR_DIRECCION_CONTRIBUYENTE)||', '||
                  (SELECT TE.DESCRIPCION_TIPO_EDIFICACION FROM TIPO_EDIFICACION TE WHERE DC.TIPO_EDIFICACION_D_C = TE.CODIGO_TIPO_EDIFICACION)||' '||
                   TRIM(DC.EDIFICACION_DIR_CONTRIBUYENTE)||', '||
                  (SELECT TP.DESCRIPCION_TIPO_LOCAL FROM TIPO_LOCAL TP WHERE DC.TIPO_LOCAL_D_C = TP.CODIGO_TIPO_LOCAL)||' '||
                   TRIM(DC.LOCAL_DIRECCION_CONTRIBUYENTE)||', '||
                  TRIM(DC.REFERENCIA_DIRECCION_C)DOMICILIO_FISCAL,
                    (SELECT UB.NOMBRE_ESTADO
                   FROM VM_UBICACION_GEOGRAFICA UB
                 WHERE UB.ID_CENTRO_POBLADO = DC.UBICACION_GEOGRAFICA ) NOMBRE_ESTADO,
                   (SELECT UB.NOMBRE_MUNICIPIO
                  FROM VM_UBICACION_GEOGRAFICA UB
                 WHERE UB.ID_CENTRO_POBLADO = DC.UBICACION_GEOGRAFICA ) NOMBRE_MUNICIPIO,
                  (SELECT UB.NOMBRE_PARROQUIA
                  FROM VM_UBICACION_GEOGRAFICA UB
                 WHERE UB.ID_CENTRO_POBLADO = DC.UBICACION_GEOGRAFICA) NOMBRE_PARROQUIA,
                  (SELECT UB.NOMBRE_CENTRO_POBLADO
                  FROM VM_UBICACION_GEOGRAFICA UB
                 WHERE UB.ID_CENTRO_POBLADO = DC.UBICACION_GEOGRAFICA) NOMBRE_CIUDAD,
                 AE.FECHA_REGISTRO_AE            FECHA_EMISION_AE,
                 AE.NUMERO_CERTIFICADO_ANTERIOR  NUMERO_CERTIFICADO_AE,
                 AE.COD_ACT_ECONOMICA_ANTERIOR   CODIGO_ACTIVIDAD_ECONOMICA,
                 ( SELECT AE.DESC_ACTIVIDAD_ECONOMICA
                      FROM   ACTIVIDAD_ECONOMICA_C4 AE
                     WHERE AE.CODIGO_ACTIVIDAD_ECONOMICA =  AE.COD_ACT_ECONOMICA_ANTERIOR
                    union all
                      SELECT DAC.DESCRIPCION_DIVISION_A_E
                        FROM DIVISION_ACT_ECONOMICA_C4 DAC
                       WHERE  DAC.CODIGO_DIVISION_A_E =  AE.COD_ACT_ECONOMICA_ANTERIOR
                    union all
                     SELECT CAE.DESCRIPCION_CLASE_ACTIVIDAD_E
                       FROM CLASE_ACTIVIDAD_ECONOMICA_C4 CAE
                      WHERE CAE.CODIGO_CLASE_ACTIVIDAD_E =  AE.COD_ACT_ECONOMICA_ANTERIOR) DES_AE_ANT
           FROM  DIRECCION_CONTRIBUYENTE dc,
                 CONTRIBUYENTE C,
                 AUDITORIA_ACT_ECONOMICA_C4 AE
          WHERE C.ID_CONTRIBUYENTE = PC_RIF_CONTRIBUYENTE
            AND C.ID_CONTRIBUYENTE = DC.ID_CONTRIBUYENTE
            AND DC.TIPO_DIRECCION_CONTRIBUYENTE =  '00'
           AND  C.ID_CONTRIBUYENTE = AE.ID_CONTRIBUYENTE_AE
           ORDER BY  TO_CHAR (AE.FECHA_REGISTRO_AE, 'DD/MM/YYYY')  DESC ;


              EXCEPTION


                        WHEN OTHERS THEN
                               BEGIN
                                    pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4P_CONSULTAR_HISTORIAL_CONTRIB ',


                                                                         'RIF_CONTRIBUYENTE :'||PC_RIF_CONTRIBUYENTE, 'DATOSCONTRIBUYENTE. AUDITORIA_ACT_ECONOMICA_C4',
                                                                         SUBSTR (SQLERRM, 1, 300), NULL, PN_RESULT );
                               END;

         END ;

 END P_CONSULTAR_HISTORIAL_CONTRIB ;

PROCEDURE P_ELIMINA_CUESTIONARIO_DEF ( pn_id_CONTRIBUYENTE IN NUMBER,
                                         result             OUT NUMBER,
                                         pn_indica_commit          IN PLS_INTEGER DEFAULT Pkg_Constantes.Cp_No_Commit)
IS

PC_COD_ACT_EC VARCHAR2(4);
PC_DES_ACT_EC VARCHAR2(200);
PD_FECHA_AE    DATE;
PC_RESPUESTA1 VARCHAR2(160);
PC_RESPUESTA2A VARCHAR2(160);
PC_RESPUESTA2B VARCHAR2(160);
PC_RESPUESTA2C VARCHAR2(160);
PC_RESPUESTA3 VARCHAR2(160);
PC_NUM_CERTIFICADO VARCHAR2(160);

BEGIN

 --- este prccedimiento es llamada para eliminar la actividad economica de un contrib con firma personal

  BEGIN
   --- busca la act economica de un contribuyente y sus respuestas para luego ser
   --- enviadas a la auditoria

    SELECT AE.CODIGO_ACT_ECONOMICA,
           AE.DESCRIPCION_ACT_ECONOMICA,
           AE.FECHA_REGISTRO_ACT_ECON,
           CU.RESPUESTA_1,
           CU.RESPUESTA_2A,
           CU.RESPUESTA_2B,
           CU.RESPUESTA_2C,
           CU.RESPUESTA_3,
           AE.NUMERO_CERTIFICADO
       INTO PC_COD_ACT_EC,
            PC_DES_ACT_EC,
            PD_FECHA_AE,
            PC_RESPUESTA1,
            PC_RESPUESTA2A,
            PC_RESPUESTA2B,
            PC_RESPUESTA2C,
            PC_RESPUESTA3,
            PC_NUM_CERTIFICADO
     FROM CUESTIONARIO_ACT_ECONOMICA_C4 CU,
          ACTIVIDAD_ECONOMICA_CONTRIB AE
    WHERE CU.ID_CONTRIBUYENTE = pn_id_CONTRIBUYENTE
      AND CU.ID_CONTRIBUYENTE  = AE.ID_CONTRIBUYENTE;

     result := Pkg_Constantes.OK;

      EXCEPTION

          WHEN NO_DATA_FOUND THEN
            BEGIN
               result:= Pkg_Constantes.NODATAFOUND ;
             END;

          WHEN OTHERS THEN
               BEGIN
                    pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4.P_ELIMINA_CUESTIONARIO_DEF ',
                                                         'ID_CONTRIBUIYENTE:'||pn_id_CONTRIBUYENTE , 'DATOSCONTRIBUYENTE.AUDITORIA_ACT_ECONOMICA_C4',
                                                         SUBSTR (SQLERRM, 1, 300), NULL, result );
               END;

     END ;


     IF result = Pkg_Constantes.OK THEN


TEXT
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      --- si se consigue los datos del contrib se elimina el cuestionario


     DELETE FROM CUESTIONARIO_ACT_ECONOMICA_C4 CU
        WHERE CU.ID_CONTRIBUYENTE  = pn_id_CONTRIBUYENTE;

        result := Pkg_Constantes.OK;

        IF SQL%NOTFOUND THEN

         result:= Pkg_Constantes.NODATAFOUND ;

         else
         --- si se borra el cuestionario se llama a  P_ELIMINA_ACT_ECONOMICA_DEF para eliminar la act eco

           P_ELIMINA_ACT_ECONOMICA_DEF ( pn_id_CONTRIBUYENTE,
                                        PC_COD_ACT_EC,
                                        PC_DES_ACT_EC,
                                        PD_FECHA_AE,
                                        PC_RESPUESTA1,
                                        PC_RESPUESTA2A,
                                        PC_RESPUESTA2B,
                                        PC_RESPUESTA2C,
                                        PC_RESPUESTA3,
                                        PC_NUM_CERTIFICADO,
                                        result);

        END IF;

     END IF;

      IF result = Pkg_Constantes.OK THEN
        commit;
        else
         rollback ;
       end if;


END P_ELIMINA_CUESTIONARIO_DEF;


 PROCEDURE P_ELIMINA_ACT_ECONOMICA_DEF( PN_ID_CONTRIBUYENTE IN NUMBER,
                                        PC_COD_ACT_EC in varchar2,
                                        PC_DES_ACT_EC in varchar2,
                                        PD_FECHA_AE in DATE,
                                        PC_RESPUESTA1 in varchar2,
                                        PC_RESPUESTA2A in varchar2,
                                        PC_RESPUESTA2B in varchar2,
                                        PC_RESPUESTA2C in varchar2,
                                        PC_RESPUESTA3 in varchar2,
                                        PC_NUM_CERTIFICADO IN VARCHAR2,
                                        pn_result             OUT NUMBER)

IS

BEGIN

   --- elimina la actividad economica del contribuyente ----

    DELETE FROM ACTIVIDAD_ECONOMICA_CONTRIB AEC
    WHERE   AEC.ID_CONTRIBUYENTE = PN_ID_CONTRIBUYENTE;

    pn_result     := Pkg_Constantes.OK;

     IF SQL%NOTFOUND THEN

     pn_result  := Pkg_Constantes.NODATAFOUND ;
     rollback ;

     else

     --- si se elimina la act economica correctamente se inserta la auditoria

      P_INSERTAR_AUDITORIA  (  PN_ID_CONTRIBUYENTE,
                               PC_RESPUESTA1,
                                PC_RESPUESTA2A,
                                PC_RESPUESTA2B,
                                PC_RESPUESTA2C,
                                PC_RESPUESTA3,
                                PC_COD_ACT_EC,
                                PC_DES_ACT_EC,
                                PC_NUM_CERTIFICADO,
                                PD_FECHA_AE,
                                pn_result );

    END IF;

      IF  pn_result   = Pkg_Constantes.OK THEN
         COMMIT;
       ELSE
      pn_result  := Pkg_Constantes.NODATAFOUND ;
       END IF;


END P_ELIMINA_ACT_ECONOMICA_DEF ;


END PKG_ACTIVIDAD_ECONOMICA_C4 ;