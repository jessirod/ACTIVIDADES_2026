                                                             SUBSTR (SQLERRM, 1, 300), NULL, PN_RESULT );
                   END;

   END ;


    ----SE BUSCA LA DESCRIPCION D ELA ACTIVIDAD ECONOMICA PARA HACER UN INSERT

      LOOP

       P_CONSULTAR_DESC_DIV_AE ( TRIM(PN_COD_ACT_ECONOMICA),VC_DESCRIPCION_AE, RESULT );

       EXIT WHEN  RESULT = PKG_CONSTANTES.OK;

       IF  RESULT <>  PKG_CONSTANTES.OK THEN

       P_CONSULTAR_DESC_CLASE_AE (TRIM(PN_COD_ACT_ECONOMICA),VC_DESCRIPCION_AE, RESULT );

       END IF;


       EXIT  WHEN  RESULT = PKG_CONSTANTES.OK;

