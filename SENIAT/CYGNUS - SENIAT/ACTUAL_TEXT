         P_CONSULTA_DESC_AE ( TRIM(PN_COD_ACT_ECONOMICA),VC_DESCRIPCION_AE, RESULT );

       END IF;

       EXIT  WHEN RESULT = PKG_CONSTANTES.OK;

       END LOOP;


    IF   VN_CANT  = 0  THEN

      --- INSERTA LA ACTIVIDAD ECONOMICA DE UN CONTRIBUYENTE

      BEGIN
       ---- SE USA UN CORRELATIVO PARA LLEVAR UN CONTROL DE LOS CONTRIBUYENTES QUE REGISTRES SU ACTIVIDAD ECONOMICA

         SELECT LPAD (CORR_CODIGO_CIUU.NEXTVAL,10,0)
            INTO VN_CORRELATIVO
            FROM DUAL ;
