IS

VN_CORRELATIVO NUMBER ;
VN_CANT  NUMBER(1);
VC_DESCRIPCION_AE VARCHAR2(240);
RESULT  NUMBER;


BEGIN


   BEGIN

       SELECT COUNT(1)
       INTO VN_CANT
       FROM  ACTIVIDAD_ECONOMICA_CONTRIB  AEC
       WHERE AEC.ID_CONTRIBUYENTE = PN_ID_CONTRIBUYENTE ;


   PN_RESULT:= PKG_CONSTANTES.OK;

       EXCEPTION

          WHEN OTHERS THEN
                   BEGIN
                        pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4.P_INSERTAR_ACT_ECONOMICA ',
