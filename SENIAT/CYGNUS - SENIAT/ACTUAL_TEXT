PROCEDURE P_TRASLADA_CUESTIONARIO  ( PN_ID_CONTRIB_TEMP IN NUMBER,
                                     PN_ID_CONTRIB_DEF  IN NUMBER,
                                     PN_RESULT             OUT PLS_INTEGER)

IS

BEGIN

  ---- TRASLADA EL CUESTIONARIO DESDE TEMPORAL A DEFINITOIVO

     BEGIN

      Insert into CUESTIONARIO_ACT_ECONOMICA_C4
               (ID_CUESTIONARIO,
                ID_CONTRIBUYENTE,
                RESPUESTA_1,
                RESPUESTA_2A,
                RESPUESTA_2B,
                RESPUESTA_2C,
                RESPUESTA_3,
               FECHA_REGISTRO_CUESTIONARIO)
             ( SELECT  TC.ID_CUESTIONARIO_T,
                        PN_ID_CONTRIB_DEF,
                        TC.RESPUESTA_1_T,
                        TC.RESPUESTA_2A_T,
                        TC.RESPUESTA_2B_T,
                        TC.RESPUESTA_2C_T,
                        TC.RESPUESTA_3_T,
                        SYSDATE
                FROM APPSTEMP.T_CUESTIONA_ACT_ECONOMICA_C4 TC
                where tc.ID_CONTRIBUYENTE_T = PN_ID_CONTRIB_TEMP);

      PN_RESULT:= PKG_CONSTANTES.OK;

       EXCEPTION

          WHEN OTHERS THEN
                   BEGIN
                        pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4.P_INSERTAR_ACT_ECONOMICA ',
                                                             'ID CONTRIBUYENTE :'||PN_ID_CONTRIB_TEMP  , 'DATOSCONTRIBUYENTE.CUESTIONARIO_ACT_ECONOMICA_C4',
                                                             SUBSTR (SQLERRM, 1, 300), NULL, PN_RESULT );
                   END;

     END ;

     IF PN_RESULT= PKG_CONSTANTES.OK THEN

         BEGIN

          P_ELIMINA_CUESTIONARIO_TEMP (PN_ID_CONTRIB_TEMP, PN_RESULT);

            IF PN_RESULT = PKG_CONSTANTES.OK THEN
                  COMMIT ;
               ELSE
                  ROLLBACK ;

            END IF;

         END;

     END IF ;

 END P_TRASLADA_CUESTIONARIO ;

