PROCEDURE P_CLASE_ACT_ECO ( PN_COD_DIVISION  IN VARCHAR2,
                            PC_DES_ACT_ECON  OUT VARCHAR2,
                            C_CLASE          OUT CURSOR_CLASE_AE,
                            PN_RESULT        OUT PLS_INTEGER)

IS

VN_LONGITUD_COD NUMBER ;
VN_CANTIDAD NUMBER ;

 ------  DADA LA DIVISION SE VEERIFICA LA CLASE DE LA ACTIVIDAD ECONOMICA ---

BEGIN

  BEGIN

   -- SOLO SE HACE UN CONTEO PARA VERIFICAR QUE EXISTE EL CODIGO DIVISION EN LA TABLA CLASE ACTIVIDAD ECONOMICA, AL NO EXISTIR NO SE AVANZA -----
        SELECT COUNT (*)
          INTO VN_CANTIDAD
         FROM CLASE_ACTIVIDAD_ECONOMICA_C4 CAE
        WHERE CAE.DIVISION_CLASE_A_E = PN_COD_DIVISION;

      PN_RESULT:= PKG_CONSTANTES.OK;

        EXCEPTION

           WHEN NO_DATA_FOUND THEN
                 PN_RESULT:= PKG_CONSTANTES.NODATAFOUND;
                 PC_DES_ACT_ECON := NULL;

  END ;

IF VN_CANTIDAD >= 0 THEN

     LOOP

       BEGIN --- se verifica si la longitud de la div es de 4, de ser asi es la ACTIVIDAD ECONOMICA DEFINITIVA Y LLEGA HASTA LA CLASE

        SELECT LENGTH (PN_COD_DIVISION)
        INTO VN_LONGITUD_COD
        FROM DUAL;

        END ;

        IF VN_LONGITUD_COD = 4 THEN --- si la div es de 4, de ser asi es la ACTIVIDAD ECONOMICA DEFINITIVA

                  BEGIN

                    SELECT DAE.DESCRIPCION_DIVISION_A_E   DESCRIPCION_DIVISION
                      INTO PC_DES_ACT_ECON
                     FROM DIVISION_ACT_ECONOMICA_C4 DAE
                     WHERE DAE.CODIGO_DIVISION_A_E = PN_COD_DIVISION;

                    PN_RESULT:= PKG_CONSTANTES.OK;


                   EXCEPTION

                           WHEN NO_DATA_FOUND THEN
                                 PN_RESULT:= PKG_CONSTANTES.NODATAFOUND;
                                 PC_DES_ACT_ECON := NULL;

                   END ;

           EXIT WHEN PN_RESULT = PKG_CONSTANTES.OK ;

         ELSE --- si no es la actividad economica definitiva, entonces se le envia este cursor con el combo con la clase clase

                 BEGIN

                 OPEN C_CLASE FOR

                    SELECT CAE.CODIGO_CLASE_ACTIVIDAD_E      CODIGO_CLASE_AE,
                           CAE.DESCRIPCION_CLASE_ACTIVIDAD_E DESCRIPCION_CLASE_AE
                     FROM CLASE_ACTIVIDAD_ECONOMICA_C4 CAE
                     WHERE CAE.DIVISION_CLASE_A_E = PN_COD_DIVISION;

                    PN_RESULT:= PKG_CONSTANTES.OK;
                    PC_DES_ACT_ECON := NULL;

                  EXCEPTION
                          WHEN OTHERS THEN
                               BEGIN
                                    pkg_error_handler.p_crear_log_error (pkg_constantes.err_general, 'DATOSCONTRIBUYENTE.PKG_ACTIVIDAD_ECONOMICA_C4.P_CLASE_ACT_ECO  ',
                                                                         'DESCRIPCION ACTIVIDAD ECONOMICA DADA LA DIVISION  :'||PN_COD_DIVISION, 'CURSOR: C_CLASE,  DATOSCONTRIBUYEN
TE.CLASE_ACTIVIDAD_ECONOMICA_C4',

                                                                         SUBSTR (SQLERRM, 1, 300), NULL, PN_RESULT );
                               END;

                  END ;

          EXIT WHEN PN_RESULT = PKG_CONSTANTES.OK ;

          END IF;

      END LOOP;

END IF ;

END P_CLASE_ACT_ECO;

